            "Horde_Nls": "lib/"
        }
    },
    "autoload-dev": {},
    "config": {
        "allow-plugins": {}
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "3.x-dev"
        }
    }
}